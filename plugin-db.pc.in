prefix=@PREFIX@
includedir=@INCLUDEDIR@
libdir=@LIBDIR@

Name: plugin-db
Description: The plugin database: the pin, the address form, the files of a plugin, the store and the state
Version: @VERSION@
# pin.h's SHA-256 is libcrypto's (EVP_Digest): a program that includes it links libcrypto, and so does libplugin-db.a
Requires: libcrypto
Cflags: -I${includedir}
Libs: -L${libdir} -lplugin-db
