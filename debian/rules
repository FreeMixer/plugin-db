#!/usr/bin/make -f

MAKE_VARS = PREFIX=/usr

%:
	dh $@

override_dh_auto_install:
	dh_auto_install -- $(MAKE_VARS)
	# data/pin.json, as the package plugin-db of omx-contract's contract directory
	$(MAKE) install-contract DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) test
endif
